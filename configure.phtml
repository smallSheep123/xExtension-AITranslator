        <input id="ait-base" name="api_base_url" type="url" value="<?php echo htmlspecialchars($base, ENT_QUOTES, 'UTF-8'); ?>" placeholder="https://api.example.com/v1">
        <p class="help">HTTPS only. The extension calls <code>/chat/completions</code>.</p>
      </div>
    </div>

    <div class="form-group">
      <label class="group-name" for="ait-key">API key</label>
      <div class="group-controls">
        <input id="ait-key" name="api_key" type="password" value="" autocomplete="new-password" placeholder="<?php echo $keySaved ? 'Saved; leave blank to keep unchanged' : 'sk-...'; ?>">
      </div>
    </div>

    <div class="form-group">
      <label class="group-name">Models</label>
      <div class="group-controls">
        <label>Title model <input name="title_model" type="text" value="<?php echo htmlspecialchars($titleModel, ENT_QUOTES, 'UTF-8'); ?>"></label><br>
        <label>Content model <input name="content_model" type="text" value="<?php echo htmlspecialchars($contentModel, ENT_QUOTES, 'UTF-8'); ?>"></label><br>
        <label>Summary model <input name="summary_model" type="text" value="<?php echo htmlspecialchars($summaryModel, ENT_QUOTES, 'UTF-8'); ?>"></label>
      </div>
    </div>
  </fieldset>

  <fieldset class="form-group">
    <legend>Bilingual feed UI</legend>

    <div class="form-group">
      <label class="group-name">Automatic title translation</label>
      <div class="group-controls">
        <label><input type="checkbox" name="auto_translate_titles" value="1" <?php echo $auto ? 'checked' : ''; ?>> Translate titles as they appear while scrolling or switching feeds/categories</label>
      </div>
    </div>

    <div class="form-group">
      <label class="group-name" for="ait-mode">Default reading mode</label>
      <div class="group-controls">
        <select id="ait-mode" name="display_mode">
          <option value="bilingual" <?php echo $mode === 'bilingual' ? 'selected' : ''; ?>>Chinese + original</option>
          <option value="zh" <?php echo $mode === 'zh' ? 'selected' : ''; ?>>Chinese only</option>
          <option value="original" <?php echo $mode === 'original' ? 'selected' : ''; ?>>Original only</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label class="group-name" for="ait-batch">Title batch size</label>
      <div class="group-controls">
        <input id="ait-batch" name="title_batch_size" type="number" min="1" max="30" value="<?php echo htmlspecialchars($batch, ENT_QUOTES, 'UTF-8'); ?>">
        <p class="help">Only uncached titles are sent. Default: 12.</p>
      </div>
    </div>
  </fieldset>

  <fieldset class="form-group">
    <legend>Prompts</legend>
    <div class="form-group">
      <label class="group-name" for="ait-title-prompt">Title prompt</label>
      <div class="group-controls"><textarea id="ait-title-prompt" name="title_prompt" rows="9"><?php echo htmlspecialchars($this->getTitlePrompt(), ENT_QUOTES, 'UTF-8'); ?></textarea></div>
