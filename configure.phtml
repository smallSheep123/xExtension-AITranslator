<?php
if (!isset($this) || !$this instanceof AITranslatorExtension) {
    return;
}
$base = $this->getApiBaseUrl();
$keySaved = $this->getApiKey() !== '';
$titleModel = $this->getTitleModel();
$contentModel = $this->getContentModel();
$summaryModel = $this->getSummaryModel();
$auto = $this->getConfigValue('auto_translate_titles', '1') === '1';
$mode = $this->getConfigValue('display_mode', 'bilingual');
$batch = $this->getConfigValue('title_batch_size', '12');
?>
<form method="post" action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>">
  <input type="hidden" name="_csrf" value="<?php echo htmlspecialchars(FreshRSS_Auth::csrfToken(), ENT_QUOTES, 'UTF-8'); ?>">

  <fieldset class="form-group">
    <legend>OpenAI-compatible API</legend>

    <div class="form-group">
      <label class="group-name" for="ait-base">API base URL</label>
