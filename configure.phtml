    <div class="form-group">
      <label class="group-name" for="ait-summary-prompt">Summary prompt</label>
      <div class="group-controls"><textarea id="ait-summary-prompt" name="summary_prompt" rows="8"><?php echo htmlspecialchars($this->getSummaryPrompt(), ENT_QUOTES, 'UTF-8'); ?></textarea></div>
